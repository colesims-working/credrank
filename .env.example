# ── Required API keys ──
GOOGLE_MAPS_API_KEY="your_key_here"
GOOGLE_GEMINI_API_KEY="your_key_here"

# ── Authentication (production) ──
# Set these when deploying. The app refuses to start otherwise, unless
# ALLOW_UNAUTH=1 is set (see below).
BASIC_AUTH_USERNAME="admin"
BASIC_AUTH_PASSWORD="change_me_to_something_long_and_random"

# ── Local dev escape hatch ──
# When set to 1 (or true/yes/on), disables auth entirely. Useful for local
# development and tests. NEVER set this in production.
ALLOW_UNAUTH=1

# ── Optional: CORS ──
# Comma-separated list of origins allowed to call the API from another
# origin. Leave unset when the frontend is served from the same origin
# as the API (the default for this app).
# CORS_ORIGINS="https://credrank.example.com"
